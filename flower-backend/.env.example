NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://postgres:postgres@postgres:5432/flowers?schema=public

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

JWT_ACCESS_SECRET=replace-with-very-long-random-string-access
JWT_REFRESH_SECRET=replace-with-very-long-random-string-refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:3001
COOKIE_SECRET=replace-with-long-random-cookie-secret
ENABLE_CSRF=false

RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=120

PAYMENT_PROVIDER=PAYTR

PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_OK_URL=http://localhost:3001/checkout/success
PAYTR_FAIL_URL=http://localhost:3001/checkout/fail
PAYTR_CALLBACK_URL=http://localhost:3000/api/payments/paytr/callback
PAYTR_TIMEOUT_LIMIT=30
PAYTR_DEBUG=false
PAYTR_TEST_MODE=true
